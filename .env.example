# ==============================================================================
# PUNE PRIME TIMES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Supabase Configuration (Used by Next.js client & public routes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private Supabase Service Role Key (Used ONLY by server-side pipeline & migrations)
# NEVER commit or expose to Next.js client!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini API (Free Tier Flash-Lite)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Stock Photo Integration for generic representative cover photos
PEXELS_API_KEY=your-pexels-api-key-here

# Public Site URL (Used for canonical URLs, sitemaps, Open Graph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Branding
NEXT_PUBLIC_SITE_NAME="Pune Prime Times"
NEXT_PUBLIC_SITE_TAGLINE="Truth. Speed. Insight."

# Pipeline Configuration
OUTPUT_LANGUAGES=mr,en
MIN_SECONDS_BETWEEN_CALLS=6
DAILY_CALL_BUDGET=300
